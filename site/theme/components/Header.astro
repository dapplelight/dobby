---
// Product mark + wordmark + status badge, section tabs, search, theme and repo link.
import config from "virtual:signet-docs/config"
import Mark from "virtual:signet-docs/Mark"
import Search from "virtual:starlight/components/Search"
import ThemeSelect from "virtual:starlight/components/ThemeSelect"

const path = Astro.url.pathname
const current = config.nav
  .filter((n) => path.startsWith(n.match ?? n.href))
  .sort((a, b) => (b.match ?? b.href).length - (a.match ?? a.href).length)[0]
---

<div class="sd-header">
  <div class="sd-brand">
    <a href="/" class="sd-home"><Mark class="sd-mark" /><span class="sd-wordmark">{config.wordmark}</span></a>
    {config.badge && <span class="sd-badge" title={config.badge.note}>{config.badge.label}</span>}
  </div>
  {
    config.nav.length > 0 && (
      <nav class="sd-tabs" aria-label="Sections">
        {config.nav.map((n) => (
          <a href={n.href} aria-current={n === current ? "page" : undefined}>{n.label}</a>
        ))}
      </nav>
    )
  }
  <div class="sd-search"><Search /></div>
  <div class="sd-right">
    <ThemeSelect />
    <a class="sd-icon-link" href={`https://github.com/${config.repo}`} aria-label="GitHub repository">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
    </a>
  </div>
</div>
